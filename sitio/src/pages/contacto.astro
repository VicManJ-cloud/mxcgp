---
import Base from '../layouts/Base.astro';
import CabeceraPagina from '../components/CabeceraPagina.astro';
import { empresa, servicios } from '../data/site.js';

/**
 * Esta página no tiene formulario a propósito.
 *
 * Un formulario convierte los datos del visitante en algo que el sitio
 * recaba, y eso obliga a publicar un aviso de privacidad validado. En su
 * lugar, el botón abre el programa de correo del propio visitante con una
 * plantilla ya redactada: el sitio no recibe, almacena ni transmite nada.
 * Si algún día se reinstala el formulario, el aviso vuelve a ser necesario.
 */
const asunto = 'Solicitud de información — MX Consultores';

const plantilla = [
  'Institución:',
  'Cargo:',
  'Servicio de interés:',
  '',
  'Descripción del reto:',
  '',
  '',
].join('\r\n');

const correoConPlantilla =
  `mailto:${empresa.correo}` +
  `?subject=${encodeURIComponent(asunto)}` +
  `&body=${encodeURIComponent(plantilla)}`;

const datosUtiles = [
  {
    titulo: 'La institución y tu cargo',
    texto:
      'Saber si hablamos con una tesorería, un área de planeación o una dependencia ejecutora cambia por completo el enfoque de la propuesta.',
  },
  {
    titulo: 'El servicio que te interesa',
    texto:
      'Puede ser uno de los seis, una combinación, o simplemente el problema sin etiqueta. Cualquiera de las tres sirve para empezar.',
  },
  {
    titulo: 'El reto concreto',
    texto:
      'Qué se necesita resolver, con qué plazo y qué restricciones existen. Unas líneas bastan para dimensionar el alcance.',
  },
];
---

<Base
  titulo="Contacto"
  descripcion="Escríbenos para explorar el alcance de una posible colaboración en capacitación, evaluación de proyectos, análisis financiero o diagnóstico de mejora administrativa."
>
  <CabeceraPagina
    etiqueta="05 — Contacto"
    titulo="Conversemos sobre los retos de tu"
    acento="gobierno"
    entrada="Si tu institución requiere capacitación, evaluación de proyectos, análisis financiero o un diagnóstico de mejora administrativa, escríbenos para explorar el alcance de una posible colaboración."
  />

  <section class="banda banda--hueso">
    <div class="contenedor">
      <div class="contacto">
        <!-- Columna principal: el correo como acción única -->
        <div class="contacto__principal">
          <p class="etiqueta">Escríbenos</p>

          <p class="contacto__correo">
            <a href={`mailto:${empresa.correo}`}>{empresa.correo}</a>
          </p>

          <p class="contacto__acciones">
            <a class="boton" href={correoConPlantilla}>
              Redactar un correo <span class="flecha" aria-hidden="true">→</span>
            </a>
          </p>

          <p class="contacto__nota">
            El botón abre tu programa de correo con el asunto y una plantilla
            ya escrita. Si prefieres, copia la dirección y escríbenos desde
            donde te sea más cómodo.
          </p>

          <dl class="contacto__datos">
            <div>
              <dt>Cobertura</dt>
              <dd>
                Gobiernos municipales, estatales y organismos públicos en todo
                México.
              </dd>
            </div>
            <div>
              <dt>Qué esperar</dt>
              <dd>
                Respondemos con una propuesta de alcance a partir del reto que
                nos describas: objetivos, entregables y forma de trabajo.
              </dd>
            </div>
          </dl>
        </div>

        <!-- Columna de apoyo: qué conviene incluir -->
        <div class="contacto__guia">
          <h2 class="titulo-sm contacto__guia-titulo">
            Qué nos ayuda saber desde el primer correo
          </h2>

          <ol class="guia">
            {datosUtiles.map((d, i) => (
              <li class="guia__punto revelar">
                <span class="guia__numero">{String(i + 1).padStart(2, '0')}</span>
                <h3>{d.titulo}</h3>
                <p>{d.texto}</p>
              </li>
            ))}
          </ol>

          <details class="servicios-ref">
            <summary>Ver los seis servicios</summary>
            <ul>
              {servicios.map((s) => (
                <li><a href={`/servicios/#${s.id}`}>{s.titulo}</a></li>
              ))}
            </ul>
          </details>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .contacto {
    display: grid;
    gap: var(--e40);
  }
  @media (min-width: 62rem) {
    .contacto {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--e64);
    }
  }

  /* ------------------------------------------------------ Columna correo */

  .contacto__principal .etiqueta {
    margin-bottom: var(--e16);
  }

  .contacto__correo {
    font-family: var(--fuente-display);
    font-size: clamp(1.5rem, 3.4vw, 2.25rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    word-break: break-word;
  }
  .contacto__correo a {
    color: var(--tinta);
    text-decoration: none;
    border-bottom: 2px solid var(--indigo);
    transition: color var(--transicion);
  }
  .contacto__correo a:hover {
    color: var(--indigo);
  }

  .contacto__acciones {
    margin-top: var(--e32);
  }

  .contacto__nota {
    max-width: 38ch;
    margin-top: var(--e16);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--tinta-meta);
  }

  .contacto__datos {
    margin: var(--e40) 0 0;
    display: grid;
    gap: var(--e24);
  }
  .contacto__datos > div {
    padding-top: var(--e16);
    border-top: 1px solid var(--linea-fuerte);
  }
  .contacto__datos dt {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.143em;
    text-transform: uppercase;
    color: var(--tinta-meta);
    margin-bottom: var(--e8);
  }
  .contacto__datos dd {
    margin: 0;
    max-width: 40ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--tinta-sec);
  }

  /* -------------------------------------------------------- Columna guía */

  .contacto__guia-titulo {
    margin-bottom: var(--e24);
  }

  .guia {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--e16);
  }

  .guia__punto {
    position: relative;
    padding: var(--e24);
    border-radius: var(--r-tarjeta);
    background: var(--papel);
    border: 1px solid var(--linea);
  }

  .guia__numero {
    display: block;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.143em;
    color: var(--indigo);
    font-variant-numeric: tabular-nums;
    margin-bottom: var(--e8);
  }

  .guia__punto h3 {
    font-size: 1rem;
    letter-spacing: -0.015em;
    margin-bottom: var(--e8);
  }

  .guia__punto p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--tinta-sec);
  }

  /* Lista de servicios plegada, para no repetir la página de Servicios */
  .servicios-ref {
    margin-top: var(--e24);
    padding-top: var(--e24);
    border-top: 1px solid var(--linea-fuerte);
  }

  .servicios-ref summary {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--indigo);
    cursor: pointer;
  }
  .servicios-ref summary:hover {
    text-decoration: underline;
  }

  .servicios-ref ul {
    list-style: none;
    margin: var(--e16) 0 0;
    padding: 0;
    display: grid;
    gap: 0.625rem;
  }
  .servicios-ref a {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--tinta-sec);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color var(--transicion), border-color var(--transicion);
  }
  .servicios-ref a:hover {
    color: var(--tinta);
    border-bottom-color: var(--linea-fuerte);
  }
</style>
