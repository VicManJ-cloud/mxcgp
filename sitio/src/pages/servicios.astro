---
import Base from '../layouts/Base.astro';
import CabeceraPagina from '../components/CabeceraPagina.astro';
import Cierre from '../components/Cierre.astro';
import Glifo from '../components/Glifo.astro';
import { servicios } from '../data/site.js';
---

<Base
  titulo="Servicios de consultoría"
  descripcion="Capacitación en evaluación socioeconómica, análisis financiero y finanzas públicas, diagnóstico institucional, planes de mejora, fortalecimiento del impuesto predial y asesoría especializada."
>
  <CabeceraPagina
    etiqueta="02 — Servicios de consultoría"
    titulo="Seis líneas de"
    acento="trabajo"
    entrada="Servicios modulares que pueden contratarse individualmente o integrarse en programas de fortalecimiento institucional."
  />

  <section class="banda banda--hueso">
    <div class="contenedor">
      <div class="rejilla rejilla--2">
        {servicios.map((s, i) => (
          <article class="tarjeta tarjeta--servicio revelar" id={s.id}>
            <div class="tarjeta__cabecera">
              <span class="tarjeta__numero">
                {String(i + 1).padStart(2, '0')}
              </span>
              <Glifo nombre={s.glifo} />
            </div>
            <h2>{s.titulo}</h2>
            <p>{s.resumen}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Cierre
    etiqueta="Siguiente paso"
    titulo="Cuéntanos el reto de tu institución y diseñemos una"
    acento="propuesta"
    boton="Escríbenos"
  />
</Base>

<style>
  .tarjeta--servicio {
    scroll-margin-top: 7rem;
  }
  .tarjeta--servicio:target {
    border-color: var(--indigo);
    background: var(--indigo-lavado);
  }
  .tarjeta--servicio h2 {
    font-size: 1.1875rem;
  }
</style>
