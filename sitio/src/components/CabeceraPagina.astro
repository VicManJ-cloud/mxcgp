---
import Orbe from './Orbe.astro';

const { etiqueta, titulo, acento, entrada } = Astro.props;
---

<section class="banda--oscura cabecera-pagina">
  <Orbe posicion="derecha" tono="indigo" />
  <div class="contenedor banda__interior">
    <p class="etiqueta">{etiqueta}</p>
    <h1 class="display--sm cabecera-pagina__titulo">
      {titulo}{acento && <> <span class="acento">{acento}</span></>}
    </h1>
    {entrada && <p class="cabecera-pagina__entrada">{entrada}</p>}
  </div>
</section>

<style>
  .cabecera-pagina {
    /* Compensa la píldora flotante que sobrevuela la parte superior */
    padding-block: clamp(7rem, 12vw, 10rem) clamp(3rem, 6vw, 4.5rem);
    margin-top: calc(-1 * var(--alto-cabecera));
  }

  .cabecera-pagina .etiqueta {
    margin-bottom: var(--e24);
  }

  .cabecera-pagina__titulo {
    max-width: 17ch;
    color: var(--blanco);
  }

  .cabecera-pagina__entrada {
    max-width: 38rem;
    margin-top: var(--e24);
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    line-height: 1.5;
    color: var(--tinta-inv-sec);
  }
</style>
