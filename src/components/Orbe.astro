---
/**
 * Orbe atmosférico. Masa de color difusa con textura de grano, recortada
 * parcialmente por el borde de la banda. Es atmósfera, no contenido.
 *
 * El grano se genera con feTurbulence en SVG, así que no hay ninguna
 * imagen que descargar.
 */
const { posicion = 'derecha', tono = 'indigo' } = Astro.props;

// Cada orbe necesita su propio id de filtro: varios conviven en una misma
// página y los ids duplicados son HTML inválido.
const idGrano = `grano-${Math.random().toString(36).slice(2, 9)}`;
---

<div
  class:list={['orbe', `orbe--${posicion}`, `orbe--${tono}`]}
  aria-hidden="true"
>
  <svg class="orbe__grano" aria-hidden="true" focusable="false">
    <filter id={idGrano}>
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.85"
        numOctaves="3"
        stitchTiles="stitch"
      />
      <feColorMatrix type="saturate" values="0" />
    </filter>
    <rect width="100%" height="100%" filter={`url(#${idGrano})`} />
  </svg>
</div>

<style>
  .orbe {
    position: absolute;
    z-index: 0;
    width: clamp(20rem, 52vw, 40rem);
    aspect-ratio: 1;
    border-radius: 9999px;
    pointer-events: none;
    isolation: isolate;
  }

  .orbe--indigo {
    background: radial-gradient(
      circle at 38% 34%,
      rgba(124, 134, 240, 0.26) 0%,
      rgba(63, 71, 149, 0.14) 34%,
      rgba(17, 18, 24, 0) 66%
    );
  }

  .orbe--ambar {
    background: radial-gradient(
      circle at 38% 34%,
      rgba(224, 166, 60, 0.13) 0%,
      rgba(122, 90, 22, 0.08) 36%,
      rgba(17, 18, 24, 0) 66%
    );
  }

  .orbe--derecha {
    top: 50%;
    right: clamp(-18rem, -16vw, -9rem);
    translate: 0 -50%;
  }

  .orbe--izquierda {
    top: 42%;
    left: clamp(-20rem, -18vw, -11rem);
    translate: 0 -50%;
  }

  .orbe--inferior {
    bottom: clamp(-18rem, -16vw, -10rem);
    left: 50%;
    translate: -50% 0;
  }

  /* Grano: rompe el degradado para que no se lea como un gradiente plano.
     Lleva la misma máscara radial que el orbe; sin ella pintaba un disco
     opaco de borde duro sobre todo el círculo. */
  .orbe__grano {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    opacity: 0.07;
    mix-blend-mode: overlay;
    -webkit-mask-image: radial-gradient(
      circle at 38% 34%,
      #000 0%,
      rgba(0, 0, 0, 0.35) 38%,
      transparent 66%
    );
    mask-image: radial-gradient(
      circle at 38% 34%,
      #000 0%,
      rgba(0, 0, 0, 0.35) 38%,
      transparent 66%
    );
  }

  @media (max-width: 47.99rem) {
    .orbe {
      width: 26rem;
      opacity: 0.8;
    }
  }
</style>
