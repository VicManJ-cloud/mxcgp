---
/**
 * Orbe atmosférico. Masa de color difusa con textura de grano, recortada
 * parcialmente por el borde de la banda. Es atmósfera, no contenido.
 *
 * El grano se genera con feTurbulence en SVG, así que no hay ninguna
 * imagen que descargar.
 */
const { posicion = 'derecha', tono = 'indigo' } = Astro.props;

// Cada orbe necesita su propio id de filtro: varios conviven en una misma
// página y los ids duplicados son HTML inválido.
const idGrano = `grano-${Math.random().toString(36).slice(2, 9)}`;
---

<div
  class:list={['orbe', `orbe--${posicion}`, `orbe--${tono}`]}
  aria-hidden="true"
>
  <svg class="orbe__grano" aria-hidden="true" focusable="false">
    <filter id={idGrano}>
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.85"
        numOctaves="3"
        stitchTiles="stitch"
      />
      <feColorMatrix type="saturate" values="0" />
    </filter>
    <rect width="100%" height="100%" filter={`url(#${idGrano})`} />
  </svg>
</div>

<style>
  .orbe {
    position: absolute;
    z-index: 0;
    width: clamp(20rem, 52vw, 40rem);
    aspect-ratio: 1;
    border-radius: 9999px;
    pointer-events: none;
    isolation: isolate;
  }

  .orbe--indigo {
    background: radial-gradient(
      circle at 34% 30%,
      rgba(124, 134, 240, 0.55) 0%,
      rgba(63, 71, 149, 0.34) 36%,
      rgba(17, 18, 24, 0) 70%
    );
  }

  .orbe--ambar {
    background: radial-gradient(
      circle at 34% 30%,
      rgba(224, 166, 60, 0.28) 0%,
      rgba(122, 90, 22, 0.2) 38%,
      rgba(17, 18, 24, 0) 70%
    );
  }

  .orbe--derecha {
    top: 50%;
    right: clamp(-14rem, -12vw, -6rem);
    translate: 0 -50%;
  }

  .orbe--izquierda {
    top: 42%;
    left: clamp(-16rem, -14vw, -8rem);
    translate: 0 -50%;
  }

  .orbe--inferior {
    bottom: clamp(-18rem, -16vw, -10rem);
    left: 50%;
    translate: -50% 0;
  }

  /* Grano: rompe el degradado para que no se vea como un gradiente plano */
  .orbe__grano {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    opacity: 0.16;
    mix-blend-mode: overlay;
  }

  @media (max-width: 47.99rem) {
    .orbe {
      width: 26rem;
      opacity: 0.8;
    }
  }
</style>
