---
import MarcaFondo from './MarcaFondo.astro';
import { navegacion, empresa } from '../data/site.js';
const anio = new Date().getFullYear();
---

<footer class="pie banda--oscura">
  <MarcaFondo />
  <div class="contenedor banda__interior">
    <div class="pie__principal">
      <div class="pie__marca">
        <img
          src="/logo/mx-horizontal-negativo.png"
          alt={empresa.nombre}
          width="1400"
          height="490"
          loading="lazy"
          decoding="async"
        />
        <p class="pie__descripcion">
          Fortalecemos la gestión pública de los gobiernos estatales y
          municipales mediante soluciones técnicas y financieras.
        </p>
      </div>

      <nav class="pie__nav" aria-label="Pie de página">
        <h2 class="etiqueta">Navegación</h2>
        <ul>
          {navegacion.map((item) => (
            <li><a href={item.href}>{item.texto}</a></li>
          ))}
        </ul>
      </nav>

      <div class="pie__contacto">
        <h2 class="etiqueta">Contacto</h2>
        <p class="pie__correo">
          <a href={`mailto:${empresa.correo}`}>{empresa.correo}</a>
        </p>
        <p class="pie__nota">
          Gobiernos municipales, estatales y organismos públicos en todo México.
        </p>
      </div>
    </div>

    <div class="pie__legal">
      <p>© {anio} {empresa.nombre}. Todos los derechos reservados.</p>
      <p><a href="/aviso-privacidad/">Aviso de privacidad</a></p>
    </div>
  </div>
</footer>

<style>
  .pie {
    padding-block: clamp(3.5rem, 7vw, 5rem) var(--e32);
  }

  .pie__principal {
    display: grid;
    gap: var(--e40);
    padding-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  @media (min-width: 48rem) {
    .pie__principal {
      grid-template-columns: 1.6fr 1fr 1.2fr;
      gap: clamp(2rem, 5vw, 4rem);
    }
  }

  .pie__marca img {
    height: 3.5rem;
    width: auto;
    margin-bottom: var(--e24);
  }

  .pie__descripcion {
    max-width: 32ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--tinta-inv-sec);
  }

  .pie h2 {
    margin-bottom: var(--e16);
  }

  .pie ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.625rem;
  }

  .pie a {
    color: var(--tinta-inv-sec);
    text-decoration: none;
    font-size: 0.9375rem;
    transition: color var(--transicion);
  }
  .pie a:hover {
    color: var(--blanco);
  }

  .pie__correo {
    font-size: 1rem;
    font-weight: 500;
    word-break: break-word;
  }
  .pie__correo a {
    color: var(--indigo-claro);
    font-size: inherit;
  }
  .pie__correo a:hover {
    color: var(--blanco);
  }

  .pie__nota {
    margin-top: var(--e16);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--tinta-inv-meta);
    max-width: 28ch;
  }

  .pie__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--e8) var(--e32);
    padding-top: var(--e32);
    border-top: 1px solid var(--linea-oscura);
    font-size: 0.8125rem;
    color: var(--tinta-inv-meta);
  }
  .pie__legal a {
    font-size: inherit;
    color: var(--tinta-inv-meta);
  }
</style>
