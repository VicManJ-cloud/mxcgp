---
import { navegacion, empresa } from '../data/site.js';
const actual = Astro.url.pathname;
const esActivo = (href) =>
  href === '/' ? actual === '/' : actual.startsWith(href);
---

<header class="cabecera">
  <div class="cabecera__pista">
    <div class="pildora sobre-oscuro" data-pildora>
      <a
        class="pildora__marca"
        href="/"
        aria-label={`${empresa.nombre} — Inicio`}
      >
        <img
          src="/logo/mx-horizontal-negativo.png"
          alt={empresa.nombre}
          width="1400"
          height="490"
          decoding="async"
        />
      </a>

      <nav class="pildora__nav" id="menu-principal" aria-label="Principal">
        <ul>
          {navegacion.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['nav-enlace', { 'es-activo': esActivo(item.href) }]}
                aria-current={esActivo(item.href) ? 'page' : undefined}
              >
                {item.texto}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="pildora__acciones">
        <a class="boton boton--compacto pildora__cta" href="/contacto/">
          Agendar una conversación
        </a>

        <button
          class="pildora__toggle"
          type="button"
          aria-expanded="false"
          aria-controls="menu-principal"
          data-toggle
        >
          <span class="visualmente-oculto">Abrir menú</span>
          <span class="hamburguesa" aria-hidden="true"></span>
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  /* La barra flota sobre el contenido con aire arriba, como una semilla
     prensada sobre el lienzo. No empuja al contenido: lo sobrevuela. */
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 200;
    padding-block: var(--e16);
    pointer-events: none;
  }

  .cabecera__pista {
    width: 100%;
    max-width: var(--ancho);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .pildora {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--e24);
    padding: 0.5rem 0.5rem 0.5rem 1.25rem;
    border-radius: var(--r-pildora);
    background: rgba(17, 18, 24, 0.9);
    border: 1px solid var(--linea-oscura);
    box-shadow: var(--sombra-nav);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    pointer-events: auto;
  }

  .pildora__marca {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    height: var(--alto-logo);
  }
  .pildora__marca img {
    height: 100%;
    width: auto;
  }

  .pildora__nav {
    flex: 1;
  }
  .pildora__nav ul {
    display: flex;
    align-items: center;
    gap: var(--e8);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-enlace {
    display: block;
    padding: 0.4375rem 0.75rem;
    border-radius: var(--r-boton);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: -0.003em;
    text-decoration: none;
    color: var(--tinta-inv-sec);
    white-space: nowrap;
    transition: color var(--transicion), background var(--transicion);
  }
  .nav-enlace:hover {
    color: var(--blanco);
    background: rgba(255, 255, 255, 0.06);
  }
  .nav-enlace.es-activo {
    color: var(--blanco);
    background: var(--indigo-profundo);
  }

  .pildora__acciones {
    display: flex;
    align-items: center;
    gap: var(--e8);
    flex-shrink: 0;
  }

  .pildora__cta {
    background: var(--indigo-vivo);
    color: var(--lienzo);
    border-radius: var(--r-pildora);
    padding: 0.5rem 1.125rem;
    white-space: nowrap;
  }
  .pildora__cta:hover {
    background: var(--indigo-claro);
  }

  /* ------------------------------------------------------------- Móvil */

  .pildora__toggle {
    display: none;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--linea-oscura);
    border-radius: var(--r-chip);
    background: transparent;
    cursor: pointer;
  }

  .hamburguesa,
  .hamburguesa::before,
  .hamburguesa::after {
    display: block;
    width: 1.0625rem;
    height: 1.5px;
    border-radius: 2px;
    background: var(--blanco);
    transition: transform var(--transicion), opacity var(--transicion);
  }
  .hamburguesa {
    position: relative;
  }
  .hamburguesa::before,
  .hamburguesa::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .hamburguesa::before {
    top: -5px;
  }
  .hamburguesa::after {
    top: 5px;
  }

  [aria-expanded='true'] .hamburguesa {
    background: transparent;
  }
  [aria-expanded='true'] .hamburguesa::before {
    transform: translateY(5px) rotate(45deg);
  }
  [aria-expanded='true'] .hamburguesa::after {
    transform: translateY(-5px) rotate(-45deg);
  }

  @media (max-width: 66rem) {
    .pildora__toggle {
      display: flex;
    }

    .pildora {
      flex-wrap: wrap;
      justify-content: space-between;
    }

    .pildora__nav {
      order: 3;
      flex-basis: 100%;
      display: none;
    }
    .pildora__nav[data-abierto] {
      display: block;
    }

    .pildora__nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      padding: var(--e8) 0 var(--e8);
      margin-top: var(--e8);
      border-top: 1px solid var(--linea-oscura);
    }

    .nav-enlace {
      padding: 0.75rem;
      font-size: 0.9375rem;
    }

    .pildora__cta {
      display: none;
    }
    .pildora__nav[data-abierto] ~ .pildora__acciones .pildora__cta {
      display: inline-flex;
    }
  }

  @media (max-width: 30rem) {
    .pildora {
      padding-left: 1rem;
    }
  }
</style>

<script>
  const boton = document.querySelector('[data-toggle]');
  const menu = document.getElementById('menu-principal');
  const etiqueta = boton?.querySelector('.visualmente-oculto');

  if (boton && menu) {
    boton.addEventListener('click', () => {
      const abierto = boton.getAttribute('aria-expanded') === 'true';
      boton.setAttribute('aria-expanded', String(!abierto));
      menu.toggleAttribute('data-abierto', !abierto);
      if (etiqueta) etiqueta.textContent = abierto ? 'Abrir menú' : 'Cerrar menú';
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && boton.getAttribute('aria-expanded') === 'true') {
        boton.click();
        boton.focus();
      }
    });
  }
</script>
