---
import { navegacion, empresa } from '../data/site.js';
const actual = Astro.url.pathname;
const esActivo = (href) =>
  href === '/' ? actual === '/' : actual.startsWith(href);
---

<header class="cabecera">
  <div class="cabecera__pista">
    <!-- La marca vive en su propia pieza flotante, no dentro de la barra de
         navegación: así su tamaño no queda atado a la altura del menú. -->
    <a
      class="marca sobre-oscuro"
      href="/"
      aria-label={`${empresa.nombre} — Inicio`}
    >
      <img
        src="/logo/mx-horizontal-negativo.png"
        alt={empresa.nombre}
        width="1400"
        height="490"
        decoding="async"
      />
    </a>

    <div class="pildora sobre-oscuro">
      <nav class="pildora__nav" id="menu-principal" aria-label="Principal">
        <ul>
          {navegacion.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['nav-enlace', { 'es-activo': esActivo(item.href) }]}
                aria-current={esActivo(item.href) ? 'page' : undefined}
              >
                {item.texto}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <a class="pildora__cta" href="/contacto/">Agendar una conversación</a>

      <button
        class="pildora__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="menu-principal"
        data-toggle
      >
        <span class="visualmente-oculto">Abrir menú</span>
        <span class="hamburguesa" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 200;
    padding-block: var(--e16);
    pointer-events: none;
  }

  .cabecera__pista {
    width: 100%;
    max-width: var(--ancho);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e16);
  }

  /* Superficie compartida por las dos piezas flotantes */
  .marca,
  .pildora {
    background: rgba(17, 18, 24, 0.9);
    border: 1px solid var(--linea-oscura);
    border-radius: var(--r-pildora);
    box-shadow: var(--sombra-nav);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    pointer-events: auto;
  }

  .marca {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    height: var(--alto-marca);
    padding-inline: clamp(1rem, 2vw, 1.5rem);
    transition: border-color var(--transicion);
  }
  .marca:hover {
    border-color: var(--indigo-vivo);
  }
  .marca img {
    height: var(--alto-logo);
    width: auto;
  }

  .pildora {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--e8);
    padding: var(--e8);
  }

  .pildora__nav ul {
    display: flex;
    align-items: center;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-enlace {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: var(--r-boton);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: -0.003em;
    text-decoration: none;
    color: var(--tinta-inv-sec);
    white-space: nowrap;
    transition: color var(--transicion), background var(--transicion);
  }
  .nav-enlace:hover {
    color: var(--blanco);
    background: rgba(255, 255, 255, 0.06);
  }
  .nav-enlace.es-activo {
    color: var(--blanco);
    background: var(--indigo-profundo);
  }

  .pildora__cta {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1.125rem;
    border-radius: var(--r-pildora);
    background: var(--indigo-vivo);
    color: var(--lienzo);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: -0.003em;
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--transicion);
  }
  .pildora__cta:hover {
    background: var(--indigo-claro);
  }

  /* ------------------------------------------------------------- Móvil */

  .pildora__toggle {
    display: none;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: var(--r-chip);
    background: transparent;
    cursor: pointer;
  }

  .hamburguesa,
  .hamburguesa::before,
  .hamburguesa::after {
    display: block;
    width: 1.0625rem;
    height: 1.5px;
    border-radius: 2px;
    background: var(--blanco);
    transition: transform var(--transicion), opacity var(--transicion);
  }
  .hamburguesa {
    position: relative;
  }
  .hamburguesa::before,
  .hamburguesa::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .hamburguesa::before {
    top: -5px;
  }
  .hamburguesa::after {
    top: 5px;
  }

  [aria-expanded='true'] .hamburguesa {
    background: transparent;
  }
  [aria-expanded='true'] .hamburguesa::before {
    transform: translateY(5px) rotate(45deg);
  }
  [aria-expanded='true'] .hamburguesa::after {
    transform: translateY(-5px) rotate(-45deg);
  }

  @media (max-width: 68rem) {
    .pildora__toggle {
      display: flex;
    }

    /* El menú se despliega como panel propio bajo la píldora */
    .pildora__nav {
      position: absolute;
      top: calc(100% + var(--e8));
      right: 0;
      min-width: 15rem;
      padding: var(--e8);
      border: 1px solid var(--linea-oscura);
      border-radius: var(--r-tarjeta);
      background: rgba(17, 18, 24, 0.96);
      box-shadow: var(--sombra-nav);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      display: none;
    }
    .pildora__nav[data-abierto] {
      display: block;
    }

    .pildora__nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
    }

    .nav-enlace {
      padding: 0.75rem;
      font-size: 0.9375rem;
    }
  }

  @media (max-width: 40rem) {
    .pildora__cta {
      display: none;
    }
  }
</style>

<script>
  const boton = document.querySelector('[data-toggle]');
  const menu = document.getElementById('menu-principal');
  const etiqueta = boton?.querySelector('.visualmente-oculto');

  if (boton && menu) {
    const cerrar = () => {
      boton.setAttribute('aria-expanded', 'false');
      menu.removeAttribute('data-abierto');
      if (etiqueta) etiqueta.textContent = 'Abrir menú';
    };

    boton.addEventListener('click', () => {
      const abierto = boton.getAttribute('aria-expanded') === 'true';
      boton.setAttribute('aria-expanded', String(!abierto));
      menu.toggleAttribute('data-abierto', !abierto);
      if (etiqueta) etiqueta.textContent = abierto ? 'Abrir menú' : 'Cerrar menú';
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && boton.getAttribute('aria-expanded') === 'true') {
        cerrar();
        boton.focus();
      }
    });

    // Al ser un panel flotante, un clic fuera debe cerrarlo.
    document.addEventListener('click', (e) => {
      if (
        boton.getAttribute('aria-expanded') === 'true' &&
        !menu.contains(e.target) &&
        !boton.contains(e.target)
      ) {
        cerrar();
      }
    });
  }
</script>
