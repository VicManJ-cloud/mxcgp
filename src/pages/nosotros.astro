---
import Base from '../layouts/Base.astro';
import CabeceraPagina from '../components/CabeceraPagina.astro';
import Cierre from '../components/Cierre.astro';

const formaDeTrabajar = [
  {
    titulo: 'Escuchamos y diagnosticamos',
    texto:
      'Entendemos el contexto, las restricciones y las prioridades reales de la institución.',
  },
  {
    titulo: 'Analizamos información y alternativas',
    texto:
      'Aplicamos metodologías reconocidas para contrastar opciones con evidencia.',
  },
  {
    titulo: 'Capacitamos y transferimos conocimiento',
    texto:
      'Dejamos capacidad instalada en los equipos, no solo un documento entregado.',
  },
  {
    titulo: 'Entregamos propuestas prácticas',
    texto:
      'Recomendaciones aplicables y herramientas para dar seguimiento a los resultados.',
  },
];
---

<Base
  titulo="Nosotros"
  descripcion="Especialistas en capacitación, evaluación de proyectos y finanzas públicas con experiencia directa en dependencias públicas, instituciones financieras y gobiernos estatales."
>
  <CabeceraPagina
    etiqueta="04 — Nosotros"
    titulo="Experiencia al servicio de las"
    acento="instituciones"
  />

  <section class="banda banda--clara">
    <div class="contenedor">
      <div class="perfil">
        <div class="perfil__texto">
          <p class="entradilla">
            MX Consultores en Gestión Pública está integrado por especialistas
            en capacitación, evaluación de proyectos y finanzas públicas que han
            laborado en diversas dependencias públicas y financieras y gobiernos
            estatales.
          </p>
          <p class="texto-sec">
            Esta trayectoria reúne conocimientos técnicos y experiencia directa
            en el funcionamiento de la administración pública. Nuestro enfoque
            consiste en comprender las necesidades de cada institución y
            traducir el análisis en recomendaciones claras, viables y orientadas
            a resultados.
          </p>
        </div>

        <!-- Cita editorial: el único trazo serif del sistema.
             Si en el futuro hay fotografía del equipo, este panel es el
             lugar donde entraría. -->
        <aside class="perfil__panel">
          <blockquote class="cita">
            <p class="serif cita__texto">
              Traducir el análisis en recomendaciones claras, viables y
              orientadas a resultados.
            </p>
            <img
              class="cita__marca"
              src="/logo/mx-vertical.png"
              alt=""
              width="800"
              height="800"
              loading="lazy"
            />
          </blockquote>
        </aside>
      </div>
    </div>
  </section>

  <section class="banda banda--hueso">
    <div class="contenedor">
      <div class="encabezado">
        <p class="etiqueta">Nuestra forma de trabajar</p>
        <h2 class="display--sm">
          Del diagnóstico a la <span class="acento">capacidad</span> instalada
        </h2>
      </div>

      <div class="rejilla rejilla--4">
        {formaDeTrabajar.map((p, i) => (
          <article class="tarjeta revelar">
            <span class="tarjeta__numero">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Cierre
    titulo="Conversemos sobre los retos de tu"
    acento="gobierno"
    boton="Contactar"
  />
</Base>

<style>
  .perfil {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
  }

  @media (min-width: 62rem) {
    .perfil {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    }
  }

  .perfil__texto > * + * {
    margin-top: var(--e24);
  }

  .perfil__panel {
    padding: clamp(1.75rem, 4vw, 2.75rem);
    border-radius: var(--r-tarjeta-lg);
    background: var(--hueso);
    border: 1px solid var(--linea);
  }

  .cita {
    margin: 0;
    display: grid;
    gap: var(--e32);
    justify-items: start;
  }

  .cita__texto {
    font-size: clamp(1.375rem, 2.4vw, 1.75rem);
    line-height: 1.25;
    letter-spacing: -0.05em;
    color: var(--tinta);
    text-wrap: balance;
  }

  .cita__marca {
    width: 7.5rem;
    opacity: 0.75;
    mix-blend-mode: multiply;
  }
</style>
