---
import Base from '../layouts/Base.astro';
import CabeceraPagina from '../components/CabeceraPagina.astro';
import Cierre from '../components/Cierre.astro';

const destinatarios = [
  {
    titulo: 'Gobiernos municipales',
    texto:
      'Tesorerías, áreas de planeación, obras públicas y unidades de planeación y evaluación.',
  },
  {
    titulo: 'Gobiernos estatales',
    texto:
      'Secretarías de finanzas, planeación, infraestructura y dependencias ejecutoras de proyectos.',
  },
  {
    titulo: 'Organismos públicos y entidades descentralizadas',
    texto:
      'Equipos responsables de inversión, administración y mejora de procesos.',
  },
];

const colaboracion = [
  {
    titulo: 'Diagnóstico de necesidades',
    texto: 'Partimos de la situación real de la institución y sus prioridades.',
  },
  {
    titulo: 'Objetivos y entregables',
    texto: 'Definimos con precisión el alcance y los productos del trabajo.',
  },
  {
    titulo: 'Análisis o capacitación',
    texto:
      'Desarrollamos el estudio técnico o el programa de formación acordado.',
  },
  {
    titulo: 'Mecanismos de seguimiento',
    texto:
      'Proponemos indicadores y rutas para dar continuidad a los resultados.',
  },
];
---

<Base
  titulo="Clientes"
  descripcion="Trabajamos con gobiernos municipales y estatales, organismos públicos y entidades descentralizadas que buscan fortalecer sus capacidades técnicas y su gestión financiera."
>
  <CabeceraPagina
    etiqueta="03 — Clientes"
    titulo="A quiénes dirigimos nuestros"
    acento="servicios"
    entrada="Trabajamos con instituciones públicas que buscan fortalecer sus capacidades técnicas, mejorar su gestión financiera y tomar decisiones de inversión con mayor información."
  />

  <section class="banda banda--clara">
    <div class="contenedor">
      <div class="rejilla rejilla--3">
        {destinatarios.map((d, i) => (
          <article class="tarjeta revelar">
            <span class="tarjeta__numero">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h2>{d.titulo}</h2>
            <p>{d.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="banda banda--hueso">
    <div class="contenedor">
      <div class="encabezado">
        <p class="etiqueta">Forma de colaboración</p>
        <h2 class="display--sm">
          Del diagnóstico al <span class="acento">seguimiento</span>
        </h2>
        <p class="entradilla">
          Un proceso ordenado, con alcance y entregables definidos desde el
          inicio.
        </p>
      </div>

      <ol class="ruta">
        {colaboracion.map((c, i) => (
          <li class="ruta__paso revelar">
            <span class="ruta__numero">{String(i + 1).padStart(2, '0')}</span>
            <h3>{c.titulo}</h3>
            <p>{c.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Cierre
    titulo="¿Tu institución enfrenta un reto de gestión o de finanzas"
    acento="públicas?"
    boton="Conversemos"
  />
</Base>

<style>
  .ruta {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--e32);
  }

  @media (min-width: 48rem) {
    .ruta {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--e24);
    }
  }

  /* Cada paso arranca con un punto sobre su propio filete */
  .ruta__paso {
    position: relative;
    padding-top: var(--e40);
    border-top: 1px solid var(--linea-fuerte);
  }

  .ruta__paso::before {
    content: '';
    position: absolute;
    top: -4.5px;
    left: 0;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--indigo);
  }

  .ruta__numero {
    position: absolute;
    top: var(--e16);
    left: 0;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.143em;
    color: var(--tinta-meta);
    font-variant-numeric: tabular-nums;
  }

  .ruta__paso h3 {
    font-size: 1.0625rem;
    margin-bottom: var(--e8);
  }

  .ruta__paso p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--tinta-sec);
  }
</style>
