---
import Base from '../layouts/Base.astro';
import Orbe from '../components/Orbe.astro';
---

<Base titulo="Página no encontrada">
  <section class="banda--oscura error">
    <Orbe posicion="derecha" tono="indigo" />
    <div class="contenedor banda__interior error__interior">
      <p class="etiqueta">Error 404</p>
      <h1 class="display--sm error__titulo">
        Esta página no <span class="acento">existe</span>
      </h1>
      <p class="error__texto">
        La dirección cambió o nunca estuvo aquí. Vuelve al inicio para continuar
        navegando.
      </p>
      <p class="error__acciones">
        <a class="boton" href="/">
          Ir al inicio <span class="flecha" aria-hidden="true">→</span>
        </a>
        <a class="boton boton--fantasma" href="/contacto/">Contacto</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .error {
    padding-block: clamp(8rem, 15vw, 12rem);
    margin-top: calc(-1 * (3.5rem + var(--e16) * 2));
  }

  .error__interior {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .error .etiqueta {
    margin-bottom: var(--e24);
  }

  .error__titulo {
    max-width: 16ch;
    color: var(--blanco);
    margin-bottom: var(--e16);
  }

  .error__texto {
    max-width: 40ch;
    color: var(--tinta-inv-sec);
  }

  .error__acciones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--e8);
    margin-top: var(--e32);
  }
</style>
