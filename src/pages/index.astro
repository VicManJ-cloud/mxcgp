---
import Base from '../layouts/Base.astro';
import Orbe from '../components/Orbe.astro';
import Entregables from '../components/Entregables.astro';
import Glifo from '../components/Glifo.astro';
import Cierre from '../components/Cierre.astro';
import { servicios, principios } from '../data/site.js';
---

<Base
  titulo="Inicio"
  descripcion="Acompañamos a gobiernos municipales y estatales en el diseño, la evaluación y la mejora de sus decisiones: capacitación especializada, análisis financiero y diagnóstico institucional."
>
  <!-- 01 · Portada -->
  <section class="banda--oscura portada">
    <Orbe posicion="derecha" tono="indigo" />
    <Orbe posicion="izquierda" tono="ambar" />

    <div class="contenedor banda__interior portada__interior">
      <p class="chip chip--contorno portada__anuncio">
        Consultoría para gobiernos
        <span class="destacado">estatales y municipales</span>
      </p>

      <h1 class="display portada__titular">
        Decisiones públicas con <span class="acento">respaldo</span> técnico
      </h1>

      <p class="portada__texto">
        Acompañamos a gobiernos municipales y estatales en el diseño, la
        evaluación y la mejora de sus decisiones. Combinamos capacitación
        especializada, análisis financiero y diagnóstico institucional para
        transformar información en herramientas útiles para la administración
        pública.
      </p>

      <div class="portada__acciones">
        <a class="boton" href="/servicios/">
          Ver servicios <span class="flecha" aria-hidden="true">→</span>
        </a>
        <a class="boton boton--fantasma" href="/contacto/">Conversemos</a>
      </div>

      <!-- Tira de confianza: en lugar de logotipos de clientes, que aún no
           se pueden publicar, los tres principios del guion. -->
      <div class="tira">
        <p class="tira__intro etiqueta">Cómo trabajamos</p>
        <ul class="tira__lista">
          {principios.map((p) => (
            <li>
              <strong>{p.titulo}.</strong> {p.texto}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 02 · Servicios, banda clara -->
  <section class="banda banda--hueso">
    <div class="contenedor">
      <div class="encabezado">
        <p class="etiqueta">02 — Servicios</p>
        <h2 class="display--sm">
          Seis líneas de <span class="acento">trabajo</span>
        </h2>
        <p class="entradilla">
          Servicios modulares que pueden contratarse individualmente o
          integrarse en programas de fortalecimiento institucional.
        </p>
      </div>

      <div class="rejilla rejilla--3">
        {servicios.map((s, i) => (
          <a
            class="tarjeta tarjeta--enlace tarjeta--interactiva revelar"
            href={`/servicios/#${s.id}`}
          >
            <div class="tarjeta__cabecera">
              <span class="tarjeta__numero">
                {String(i + 1).padStart(2, '0')}
              </span>
              <Glifo nombre={s.glifo} />
            </div>
            <h3>{s.titulo}</h3>
            <p>{s.resumen}</p>
            <span class="tarjeta__pie" aria-hidden="true">Ver detalle →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 03 · Entregables, banda oscura con pila flotante -->
  <section class="banda banda--oscura">
    <Orbe posicion="izquierda" tono="indigo" />
    <div class="contenedor banda__interior">
      <div class="dos-tercios">
        <div class="dos-tercios__copia">
          <p class="etiqueta">Qué recibe la institución</p>
          <h2 class="titulo-banda">
            Análisis que se traduce en <span class="acento">decisiones</span>,
            no en documentos archivados.
          </h2>
          <p class="entradilla">
            Cada trabajo cierra con productos concretos: modelos financieros,
            matrices de evaluación, hojas de ruta con responsables e
            indicadores para dar seguimiento a los resultados.
          </p>
          <p>
            <a class="enlace" href="/clientes/">
              Cómo colaboramos <span aria-hidden="true">→</span>
            </a>
          </p>
        </div>

        <div class="dos-tercios__visual">
          <Entregables />
        </div>
      </div>
    </div>
  </section>

  <!-- 04 · Clientes, banda blanca -->
  <section class="banda banda--clara">
    <div class="contenedor">
      <div class="encabezado encabezado--centro">
        <p class="etiqueta">03 — Clientes</p>
        <h2 class="display--sm">
          Instituciones que deciden con mejor
          <span class="acento">información</span>
        </h2>
        <p class="entradilla">
          Trabajamos con organismos públicos que buscan fortalecer sus
          capacidades técnicas y su gestión financiera.
        </p>
      </div>

      <div class="rejilla rejilla--3">
        <article class="tarjeta revelar">
          <span class="tarjeta__numero">01</span>
          <h3>Gobiernos municipales</h3>
          <p>
            Tesorerías, áreas de planeación, obras públicas y unidades de
            planeación y evaluación.
          </p>
        </article>
        <article class="tarjeta revelar">
          <span class="tarjeta__numero">02</span>
          <h3>Gobiernos estatales</h3>
          <p>
            Secretarías de finanzas, planeación, infraestructura y dependencias
            ejecutoras de proyectos.
          </p>
        </article>
        <article class="tarjeta revelar">
          <span class="tarjeta__numero">03</span>
          <h3>Organismos públicos</h3>
          <p>
            Entidades descentralizadas y equipos responsables de inversión,
            administración y mejora de procesos.
          </p>
        </article>
      </div>
    </div>
  </section>

  <Cierre
    etiqueta="Siguiente paso"
    titulo="Cuéntanos el reto de tu institución y diseñemos una propuesta de trabajo."
    boton="Escríbenos"
  />
</Base>

<style>
  /* ------------------------------------------------------------ Portada */

  .portada {
    /* La píldora flota encima: hay que dejarle sitio arriba */
    padding-block: clamp(7rem, 13vw, 11rem) clamp(3rem, 6vw, 5rem);
    margin-top: calc(-1 * (3.5rem + var(--e16) * 2));
  }

  .portada__interior {
    display: grid;
    justify-items: start;
  }

  .portada__anuncio {
    margin-bottom: var(--e32);
  }

  .portada__titular {
    max-width: 14ch;
    color: var(--blanco);
  }

  .portada__texto {
    max-width: 38rem;
    margin-top: var(--e32);
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    line-height: 1.5;
    color: var(--tinta-inv-sec);
  }

  .portada__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e8);
    margin-top: var(--e40);
  }

  /* Tira de confianza bajo el llamado principal */
  .tira {
    width: 100%;
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-top: var(--e32);
    border-top: 1px solid var(--linea-oscura);
  }

  .tira__intro {
    margin-bottom: var(--e24);
  }

  .tira__lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--e24);
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--tinta-inv-sec);
  }
  .tira__lista strong {
    display: block;
    font-weight: 600;
    color: var(--blanco);
    margin-bottom: 2px;
  }

  @media (min-width: 48rem) {
    .tira__lista {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--e32);
    }
  }

  /* --------------------------------------------------- Banda dos tercios */

  .dos-tercios {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }

  @media (min-width: 62rem) {
    .dos-tercios {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    }
  }

  .dos-tercios__copia > * + * {
    margin-top: var(--e24);
  }

  /* --------------------------------------------------------- Servicios */

  .tarjeta__pie {
    margin-top: auto;
    padding-top: var(--e8);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--indigo);
    transition: transform var(--transicion);
  }
  .tarjeta--interactiva:hover .tarjeta__pie {
    transform: translateX(3px);
  }
</style>
